{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=$(printf '%s' \"$PWD\" | (md5sum 2>/dev/null || md5) | cut -c1-8); date +%s > ~/.claude/.cache-ts-$k"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "k=$(printf '%s' \"$PWD\" | (md5sum 2>/dev/null || md5) | cut -c1-8); date +%s > ~/.claude/.cache-ts-$k"
          }
        ]
      }
    ]
  }
}
